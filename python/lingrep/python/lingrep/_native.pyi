from collections.abc import Iterator, Sequence
from os import PathLike
from typing import Literal, overload
from .records import Cell, RawMatch, Span

class Schema:
    @property
    def attributes(self) -> list[str]: ...
    @staticmethod
    def _from_fields(fields: list[tuple[str, bool]]) -> Schema: ...

class Engine:
    def __init__(self, dict_path: str | PathLike[str] | None, workers: int) -> None: ...
    @property
    def dictionary_path(self) -> PathLike[str]: ...
    @property
    def dictionary_digest(self) -> str: ...
    @property
    def analysis_identity(self) -> str: ...
    @property
    def schema(self) -> Schema: ...
    def sentences(self, texts: list[str], attributes: Sequence[str] | None = ...) -> list[Sentence]: ...
    def surfaces(self, texts: list[str]) -> list[list[str]]: ...

class Token:
    @property
    def index(self) -> int: ...
    @property
    def char_span(self) -> Span | None: ...
    def __getitem__(self, key: str) -> Cell: ...
    def __getattr__(self, name: str) -> str | None: ...

class Sentence:
    @property
    def text(self) -> str: ...
    @property
    def schema(self) -> Schema: ...
    @property
    def attributes(self) -> list[str]: ...
    def _is_set(self, key: str) -> bool: ...
    @staticmethod
    def _from_projection(text: str, schema: Schema, values: list[Cell],
                         ranges: list[tuple[int, int]], word_ranges: list[tuple[int, int]],
                         word_count: int) -> Sentence: ...
    def __len__(self) -> int: ...
    def __getitem__(self, index: int) -> Token: ...
    def __iter__(self) -> Iterator[Token]: ...
    @property
    def char_spans(self) -> list[Span | None]: ...
    @overload
    def column(self, key: Literal["surface", "text", "lemma", "norm", "upos", "xpos"]) -> list[str | None]: ...
    @overload
    def column(self, key: str) -> list[Cell]: ...

class CompiledQuery:
    @property
    def diagnostics(self) -> list[str]: ...
    @property
    def schema(self) -> Schema: ...
    @property
    def attributes(self) -> list[str]: ...
    @staticmethod
    def _compile(source: str, name: str, inline: bool, schema: Schema | None = ...) -> CompiledQuery: ...
    def _batch(self, engine: Engine, texts: list[str]) -> list[list[RawMatch]]: ...
    def find_matches(self, sentence: Sentence) -> list[RawMatch]: ...
