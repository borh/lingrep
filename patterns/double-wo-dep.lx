# Double-を candidates by dependency: two を-marked nominals governed by one
# predicate (`dep.head`, `dep.rel`), as the dependency counterpart to
# `double-wo.lx`.
#
# An elided shared predicate (何を青臭いことを) has no head token, and the
# `where` clause filters the capture assignment the body already chose rather
# than searching for one that satisfies it.

defaults
  source: "research query, 2重を格 dependency criterion"
  status: "experimental"
end

test DW_DEP_WO := text=を.

set WO_PHRASE_ROLE := {obj, obl, iobj, nsubj, csubj, ccomp, xcomp,
                       advcl, acl, nmod, dep}.

role: "helper"
fragment double_wo_dep_skeleton :=
  (?<n1> []) [!@DW_DEP_WO]{0,5} (?<w1> [text=を & upos=ADP])
  [!@DW_DEP_WO]{0,8}
  (?<n2> []) [!@DW_DEP_WO]{0,5} (?<w2> [text=を & upos=ADP])
  []*
  (?<v> []).

role: "research"
category: "重複を格調査"
key: [$n1.dep.rel, $n2.dep.rel]
pattern double_wo_dep :=
  @double_wo_dep_skeleton
  where $n1 -[case]-> $w1, $n2 -[case]-> $w2,
        $v -[@WO_PHRASE_ROLE]-> $n1, $v -[@WO_PHRASE_ROLE]-> $n2.
