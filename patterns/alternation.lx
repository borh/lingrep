defaults
  status: "experimental"
  source: "Gries & Stefanowitsch 2004, Extending collostructional analysis; re-derived against unidic-cwj-202512"
end

analyzer: { family: "vibrato", resource: "unidic-cwj", segmentation: ["input", "analyzer"] }
analyzer: { family: "vibrato", resource: "unidic-csj", segmentation: ["input", "analyzer"] }

schema
  pattern alternation: string required in {"light_verb", "conditional", "negation"}
  pattern member: string required
  pattern slot: string required in {"sahen_noun", "antecedent", "verb"}
  pattern examples: list required
  pattern counterexamples: list
  fragment role: string required in {"helper"}
  status: string required in {"experimental"}
  source: string
end

# Distinctive collexeme analysis (Gries & Stefanowitsch 2004): competing
# constructions over one slot, tagged by `alternation:` and `member:`.
# UniDic makes 読める one token with `lemma=読む`, and 食べられる has the same
# token shape as the passive, so no potential family is included.

role: "helper"
fragment al_wo := [unidic.orthbase=を & unidic.pos1=助詞 & unidic.pos2=格助詞].

role: "helper"
fragment al_suru := [unidic.pos1=動詞 & lemma=為る].

role: "helper"
fragment al_okonau := [unidic.pos1=動詞 & lemma=行う].

role: "helper"
fragment al_sahen_noun :=
  ([unidic.pos1=名詞])*
  [unidic.pos1=名詞 & unidic.pos3=サ変可能].

role: "helper"
fragment al_quotative_verb :=
  [unidic.pos1=動詞 & lemma in {言う, 思う, 考える, 述べる, 感じる, 記す}].

role: "helper"
fragment al_final_predicate :=
  [unidic.pos1 in {動詞, 形容詞, 助動詞} & unidic.cform ~ /\A終止形/]
  ([unidic.pos1=補助記号 & unidic.pos2=句点])?
  $.

alternation: "light_verb"
member: "Nをする"
slot: "sahen_noun"
examples: ["実験をする。", "研究発表をする。"]
counterexamples: ["実験する。"]
key: [$noun.span.norm]
pattern lv_wo_suru :=
  (?<noun> @al_sahen_noun) @al_wo @al_suru.

alternation: "light_verb"
member: "Nを行う"
slot: "sahen_noun"
examples: ["実験を行う。", "分析を行った。"]
counterexamples: ["実験をする。"]
key: [$noun.span.norm]
pattern lv_wo_okonau :=
  (?<noun> @al_sahen_noun) @al_wo @al_okonau.

alternation: "light_verb"
member: "Nする"
slot: "sahen_noun"
examples: ["実験する。", "資料を検討している。"]
counterexamples: ["実験をする。"]
key: [$noun.span.norm]
pattern lv_compound :=
  (?<noun> @al_sahen_noun) @al_suru.

# UniDic tags conditional と as 格助詞 after some 終止形 predicates
# (研究を進めると), so `pos2` is omitted.
alternation: "conditional"
member: "と"
slot: "antecedent"
examples: ["春になると花が咲く。", "研究を進めると分かる。"]
key: [$antecedent.norm]
pattern cond_to :=
  (?<antecedent> [unidic.pos1 in {動詞, 形容詞} & unidic.cform ~ /\A終止形/])
  [unidic.orthbase=と & unidic.pos1=助詞].

alternation: "conditional"
member: "ば"
slot: "antecedent"
examples: ["雨が降れば中止する。", "実験を行わなければならない。"]
key: [$antecedent.norm]
pattern cond_ba :=
  (?<antecedent> [unidic.pos1 in {動詞, 形容詞, 助動詞} & unidic.cform ~ /\A仮定形/])
  [unidic.orthbase=ば & unidic.pos1=助詞 & unidic.pos2=接続助詞].

alternation: "conditional"
member: "たら"
slot: "antecedent"
examples: ["家に帰ったら電話する。"]
key: [$antecedent.norm]
pattern cond_tara :=
  (?<antecedent> [unidic.pos1 in {動詞, 形容詞} & unidic.cform ~ /\A連用形/])
  [unidic.pos1=助動詞 & lemma=た & unidic.cform ~ /\A仮定形/].

alternation: "conditional"
member: "なら"
slot: "antecedent"
examples: ["行くなら早いほうがいい。"]
counterexamples: ["学生なら分かる。"]
key: [$antecedent.norm]
pattern cond_nara :=
  (?<antecedent> [unidic.pos1 in {動詞, 形容詞} & unidic.cform ~ /\A終止形/])
  [unidic.pos1=助動詞 & lemma=だ & unidic.cform ~ /\A仮定形/].

alternation: "negation"
member: "ない"
slot: "verb"
examples: ["結果を確認しない。", "問題を解決できない。"]
counterexamples: ["理由を述べず終わった。"]
key: [$verb.norm]
pattern neg_nai :=
  (?<verb> [unidic.pos1=動詞 & unidic.cform ~ /\A未然形/])
  [unidic.pos1=助動詞 & lemma=ない].

alternation: "negation"
member: "ず"
slot: "verb"
examples: ["理由を述べず終わった。", "影響を及ぼさぬまま。"]
counterexamples: ["結果を確認しない。"]
key: [$verb.norm]
pattern neg_zu :=
  (?<verb> [unidic.pos1=動詞 & unidic.cform ~ /\A未然形/])
  [unidic.pos1=助動詞 & lemma=ず].

group conditional := alternation = "conditional".

policy
  resolve all partition: alternation, rank: [longest, start, end, pattern].
  exclude @cond_to with: @al_quotative_verb, relation: after, evidence: raw.
  require %conditional with: @al_final_predicate, relation: in_sentence, evidence: raw.
end
