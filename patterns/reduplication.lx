defaults
  status: "experimental"
end

# Reduplication and V-に-V emphatic repetition. In UniDic-CWJ 202512, the
# V-に-V first slot is tagged 動詞 only where a deverbal noun is not
# lexicalized: 泣きに泣いた and 待ちに待った tag their first element as 名詞
# (`orthbase` 泣き/待ち rather than 泣く/待つ).

category: "重複・強調"
examples: ["もっともっと知りたい", "ずっとずっと待っていた"]
counterexamples: ["もっと知りたい"]
pattern adv_reduplication := (?<unit> [unidic.pos1=副詞]) same_as($unit, by=unidic.kana).

category: "重複・強調"
examples: ["頑張りに頑張った", "煮詰まりに煮詰まった"]
counterexamples: ["頑張りに行った", "泣きに泣いた", "待ちに待った成果だ"]
pattern v_ni_v :=
  (?<v> [unidic.pos1=動詞 & unidic.cform=連用形-一般])
  [text=に & unidic.pos1=助詞]
  same_as($v, by=unidic.orthbase).
