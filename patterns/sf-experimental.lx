category: "S2e 立場"
examples: ["その効果を意図する"]
priority_order: 1
research_classes: ["S2B"]
意図する := [lemma=意図] @SURU.

role: "research"
layer: "S2"
category: "S2e 立場"
examples: ["妥当であると判断できる"]
priority_order: 1
research_classes: ["S2B"]
と判断できる := [text=と] [lemma=判断] [lemma=出来る].

role: "research"
layer: "S2"
category: "S2e 立場"
examples: ["その効果があることがわかる"]
priority_order: 1
research_classes: ["S2B"]
ことがわかる := @KOTO [text=が] [lemma=分かる].

role: "research"
layer: "S2"
category: "S2e 立場"
examples: ["実態においては相違ないものと位置づけてよい"]
priority_order: 1
research_classes: ["S2B", "S2E"]
てよい := @VERB_TE [lemma=良い].

role: "research"
layer: "S2"
category: "S2d 外部根拠"
examples: ["このように変更がなされたと見られる", "宝珠を失ったと見られる"]
priority_order: 1
research_classes: ["S2C"]
と見られる := [text=と] [lemma=見る] @RARE.

role: "research"
layer: "S2"
category: "S2d 外部根拠"
examples: ["適切のようだ"]
groups: ["trailing_copula"]
priority_order: 1
research_classes: ["S2C"]
output_name: "よう"
ようだ := [text=よう] @DA.

role: "research"
layer: "S2"
category: "S2d 外部根拠"
examples: ["検討するそうだ"]
groups: ["trailing_copula"]
priority_order: 1
research_classes: ["S2G"]
output_name: "そう"
そうだ := not_preceded_by([unidic.cform=連用形-一般]) [text=そう] @DA.

role: "research"
layer: "S2"
category: "S2d 外部根拠"
examples: ["確かなようである"]
groups: ["trailing_copula"]
priority_order: 1
research_classes: ["S2C"]
output_name: "よう"
ようである := [text=よう] [text=で & lemma=だ] [lemma=有る].

role: "research"
layer: "S2"
category: "S2d 外部根拠"
examples: ["A社で働いていたという"]
priority_order: 1
research_classes: ["S2G"]
# The 言う family reads `orthbase`, not `lemma`, and this is the pattern that
# forces it. UniDic's lemma for the potential 言える is 言う — the same lemma
# the plain 言う carries — so `lemma in {言う, いう}` matches 「と言える」 as
# readily as 「という」. `orthbase` preserves the distinct dictionary forms and
# keeps the two kanji / kana spellings separate.
という := [text=と] [unidic.orthbase in @IU].
#
# Seven definitions put this verb in this slot and five now read
# `unidic.orthbase in @IU`: という, ということだ, とは言い難い, というのである
# and と言われる. Both spellings, because upstream writes three of them against
# `NORM="言う"`, which is spelling-normalizing — UniDic's `orthbase` for a kana
# 「いい」 is いう, so a single-valued `unidic.orthbase=言う` would stop matching
# 「とはいいがたい」, which is upstream's own example.
#
# The other two — という指摘もある, ということである, ということで — keep
# `[text=いう & lemma=言う]`, and that is not an oversight. Upstream pins those
# three to `ORTH="いう"` (:223, :345, :356), and a surface pinned to いう cannot
# be a potential in the first place. Rewriting their second conjunct as
# `orthbase` would either say nothing new (`unidic.orthbase=いう`) or match no token at
# all (`unidic.orthbase=言う`, which the surface いう never carries). Uniformity here is
# in what the predicate means, not in which attribute spells it.

role: "research"
layer: "S2"
category: "S2d 外部根拠"
examples: ["この傾向にあることが知られている"]
priority_order: 1
research_classes: ["S2G"]
ことが知られている := @KOTO ([text=が] | [text=も]) [lemma=知る] (@RERU | @RARE) @VERB_TEIRU.

role: "research"
layer: "S2"
category: "S2d 外部根拠"
examples: ["そのことも明らかにされている"]
priority_order: 1
research_classes: ["S2G"]
明らかにされる := [lemma=明らか] [text=に] @SURU (@RERU | @RARE).

role: "research"
layer: "S2"
category: "S2d 外部根拠"
examples: ["重要であるという指摘もある"]
priority_order: 1
research_classes: ["S2G"]
という指摘もある := [text=と] [text=いう & lemma=言う] [lemma=指摘] ([text=が] | [text=も]) @ARU.

role: "research"
layer: "S1"
category: "S1f 判断再提示"
examples: ["それらの背景には共感覚の素質に他ならない"]
priority_order: 2
research_classes: ["S2A", "S3F"]
に他ならない := [text=に & lemma=に] [lemma=他] [text=なら & lemma=成る] @NAI.

role: "research"
layer: "S2"
category: "S2c 確信"
examples: ["有効な方法に違いない"]
priority_order: 1
research_classes: ["S2A"]
に違いない := [text=に] [lemma=違い] (@NAI | [lemma=有る] @MASEN).

role: "research"
layer: "S2"
category: "S2b 可能性"
examples: ["誤差によるものかもしれない"]
priority_order: 1
research_classes: ["S2D"]
かもしれない := [text=か] [text=も] [lemma=知れる] @NAIMASEN.

role: "research"
layer: "S2"
category: "S2a 推量"
examples: ["明日は雨だろう", "対比であろう"]
priority_order: 1
research_classes: ["S2C"]
だろう := @DAROU.

role: "research"
layer: "S2"
category: "S2a 推量"
examples: ["そうであろう", "可能性が高いであろう"]
priority_order: 1
research_classes: ["S2C"]
であろう := @DEAROU.

role: "research"
layer: "S2"
category: "S2a 推量"
examples: ["彼は来るはずである"]
groups: ["trailing_copula"]
priority_order: 1
research_classes: ["S2C"]
output_name: "はず"
はずである := [lemma=筈] [text=で & lemma=だ] [lemma=有る].

role: "research"
layer: "S2"
category: "S2a 推量"
examples: ["素質が高い人においては神経科学的構造が発生しやすくなるのであろう", "影響があるのであろう"]
priority_order: 1
research_classes: ["S2C"]
のであろう := [text=の] [text=で] [text=あろう & lemma=有る].

role: "research"
layer: "S2"
category: "S2a 推量"
examples: ["影響があるのではないだろうか"]
priority_order: 1
research_classes: ["S2C"]
のではないだろうか := [lemma=の] @DEWA @NAI @DAROU [text=か].

role: "research"
layer: "S2"
category: "S2d 外部根拠"
examples: ["影響があるとみられる"]
priority_order: 1
research_classes: ["S2C"]
とみられる := [text=と] [lemma=見る] (@RERU | @RARE).

