defaults
  status: "experimental"
end

# The catalog's own key schema. `required` is scoped by visibility because
# `layer`, `category`, `examples` and `research_classes` sit on all 86 patterns
# and on none of the
# 18 fragments; a flat `required` would reject this catalog. Policy keys and
# the three catalog-level compiler declarations are owned by the compiler and
# are not declared here.
schema
  pattern layer: string required in {"S0", "S1", "S2", "S3"}
  pattern category: string required
  pattern examples: list required
  pattern research_classes: list required
  pattern mapping_note: string
  pattern role: string required in {"research"}
  fragment role: string required in {"helper"}
  status: string required in {"experimental"}
end

# Experimental sentence-final patterns.
#
# `research_classes` is the research-facing taxonomy: S1A-E are non-modal
# sentence-final expressions, S2A-J are writer-attitude modalities, and S3A-F
# are representative morphemes within a final expression. A list is deliberate:
# a text such as `と言える` is both S2B thought/judgement and S3F restatement.
# `layer` remains the upstream publication-policy dimension and must not be
# inferred from, or replaced by, this taxonomy. S2J is intentionally absent:
# `てしまう` alone also has neutral perfective readings, so the catalog does not
# label it regret without an overt, reliable marker.
#
# Shared definitions are fragments and therefore never emit matches.
#
# All eight result policies this catalog was translated with are DECLARED and
# applied by the engine. They live in the policy block at the end of this file,
# as eight statements in upstream's stage order — stage 1's four per-layer
# resolves collapsed into one `resolve all partition: layer` when the language
# gained its partition-by-dimension operator, while stage 6 remains two rules
# over one anchor. Each statement carries the upstream function it translates.
#
# The block is a publication decision, not a matching one: it changes which
# records this catalog emits and never which spans it finds. See
# docs/results/2026-08-07-r1-policy-migration.md for the per-stage differential,
# and docs/results/2026-08-02-r1-sf-experimental-migration.md and
# docs/results/2026-08-04-anchor-acceptance.md, which record the first two
# migrations as they were first measured — under the per-definition keys the
# block replaced.
#
# Three approximations, named rather than hidden:
#
#   - Stage 2's negation operand is a fragment, not a token test. Upstream
#     inspects the token after the match; a fragment operand reaches the same
#     answer through the synthesized `__policy__` evidence emitter. See the
#     comment on NEG below for why it is not `NAI`.
#   - `lemma` stands in for spaCy's `norm_` throughout. They are not the same
#     normalization, and where they disagree this catalog disagrees with
#     upstream.
#   - Stage 5 NARROWS a trailing copula where upstream SPLITS it into two
#     records. `detach` cannot emit a record, so the copula half is lost rather
#     than published separately. This is why our record counts entering stage 6
#     are lower than upstream's by roughly the number of subjects.
#
# Three rows of the design's expressibility table
# (docs/design/2026-08-06-policy-sublanguage-syntax.md) are wrong, and the block
# follows upstream rather than the table: stage 3 drops the passive and not the
# aspect; stage 2's subject is @ている alone, since upstream's `_TEIRU_NAMES` is
# a one-element set; and stage 6 measures against `propositional_end`, the
# `effective_end` that `filter_pipeline.py:100` passes, not the raw sentence end.
#
# Nothing here remains caller-owned. Citation stripping is subsumed by the
# propositional_end anchor: on this corpus it IS trailing-punctuation stripping
# — 2 sentences in 545 differ — which is why a punctuation-only anchor
# suffices. On a corpus with parenthesized citations it would be a different
# rule, and this catalog would need a wider `exclude` fragment on the anchor.
# See docs/results/2026-08-04-dm-annotations-parity.md.
#
# Documentation-only citation sketches (not executable definitions):
# citation_note := 注 [upos=NUM] [text=）]?.
# citation_parenthesized_year := （ [upos in {PROPN, NOUN, X}]+ [upos=NUM] ）.

# Shared executable fragments

# The plain verb and the potential share a lemma in UniDic, so every 言う slot
# a potential can reach reads orthbase. Naming the two lists is why that is
# one edit rather than seven.
set IU := {言う, いう}.
set IERU := {言える, いえる}.
set WAKE := {わけ, 訳}.
set MONO := {物, もの}.
set TE_DE := {て, で}.

role: "helper"
fragment NAI := [text in {ない, 無い, ず, ぬ, なかっ, 無かっ, ねえ}] [text=た]?.
role: "helper"
fragment MASEN := ([text=ませ] [text=ん] | [text=ませ] [text=ん] [text=でし] [text=た]).
role: "helper"
fragment NAIMASEN := (@NAI | @MASEN).
role: "helper"
fragment ARU := ([lemma in {ある, 有る} & text not in {あろう, 有ろう, あれ, 有れ}] [text=た]? | [lemma=有る] [text=ます] | [lemma=有る] [text=まし] [text=た]).
role: "helper"
fragment DEARU := [text=で] @ARU.
role: "helper"
fragment DA := ([text in {だ, です, でし, だっ} & lemma=だ] [text=た]? | @DEARU).
role: "helper"
fragment DEWA := ([text=で] [text=は] | [text=じゃ]).
role: "helper"
fragment VERB_TE := [text in @TE_DE].
role: "helper"
fragment VERB_TEIRU := @VERB_TE [lemma=居る].
role: "helper"
fragment DEAROU := [text=で] [text=あろう].
role: "helper"
fragment DAROU := ([text in {だろう, でしょう, だろ, たろう}] | @DEAROU).
role: "helper"
fragment KOTO := [lemma in {こと, 事}].
role: "helper"
fragment RARE := [lemma=られる].
role: "helper"
fragment RERU := [lemma=れる].
role: "helper"
fragment SURU := [lemma=為る].
role: "helper"
fragment NARU := [lemma in {成る, なる} & text != なろう].

# The negation operand of stage 2's `exclude`, and deliberately NOT `NAI`.
#
# `NAI` is wider (`ない 無い ず ぬ なかっ 無かっ ねえ`), reads `orth`, and takes an
# optional trailing `た`. Reusing it would drop more `ている` records than
# the intended negation inventory, and it reads `lemma` so the inflected
# `なかっ` is still recognized.
#
# It is also the operand of a fragment-operand `exclude`, which is what makes
# "the token after `ている` is a negation" expressible at all: upstream tests a
# token, not a match, and a fragment emits through the synthesized
# `__policy__` evidence emitter at every position it matches.
role: "helper"
fragment NEG := [lemma in {ない, 無い, ぬ, ず}].

role: "helper"
anchor: {name: "propositional_end", exclude: "TRAILING_APPARATUS"}
max_nesting: {depth: 0, witness: ["これは重要である|。"], divergence: ["これは重要である|（田中）。"]}
fragment TRAILING_APPARATUS := [upos=PUNCT]+.

# _DISCOURSE_ACTIONS definitions

role: "research"
layer: "S3"
category: "論文運営・読者誘導"
examples: ["本稿の結論としておく", "仮説としておく"]
priority_order: 0
research_classes: ["S1B"]
としておく := [text=と] [text=し] @VERB_TE [lemma=置く].

role: "research"
layer: "S3"
category: "論文運営・読者誘導"
examples: ["結論としておきたい"]
priority_order: 0
research_classes: ["S1B", "S2I"]
としておきたい := [text=と] [text=し] @VERB_TE [lemma=置く] [text=たい].

role: "research"
layer: "S3"
category: "論文運営・読者誘導"
examples: ["仮定としておこう"]
priority_order: 0
research_classes: ["S1B", "S2I"]
としておこう := [text=と] [text=し] @VERB_TE [lemma=置く & unidic.cform=意志推量形].

role: "research"
layer: "S3"
category: "論文運営・読者誘導"
examples: ["概説にとどめる", "触れにとどめる"]
priority_order: 0
research_classes: ["S1B"]
にとどめる := [text=に] [lemma=留める].

role: "research"
layer: "S3"
category: "論文運営・読者誘導"
examples: ["言及としておくにとどめる"]
priority_order: 0
research_classes: ["S1B"]
としておくにとどめる := [text=と] [text=し] @VERB_TE [lemma=置く] [text=に] [lemma=留める].

