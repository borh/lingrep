role: "research"
layer: "S0"
category: "命題内容"
examples: ["分析を行う", "検討を行う"]
groups: ["s0_conditional"]
priority_order: 3
research_classes: ["S1A"]
行う := [lemma=行う].

# Membership of `%upper_layer` is a function of `layer`, so it is derived by
# the predicate below rather than restated on 77 definitions. The other three
# groups stay literal `groups:` lists deliberately: `aspect`,
# `trailing_copula` and `s0_conditional` are curated memberships — upstream
# name-lists, not functions of any metadata key — so a list is the honest
# encoding, and a derived group refuses restatement anyway
# (`LiteralEntryForDerivedGroup`).
group upper_layer := layer in {"S1", "S2", "S3"}.

# The publication decisions this catalog declares, in upstream's stage order.
# Order is semantic here and not presentational: a `resolve` before an `exclude`
# contests a different field than one after it, and `admit` reads the published
# end, so standing after the `detach` measures a trimmed record.
#
# `detach` selects `%trailing_copula` rather than naming thirteen subjects
# because the thirteen declare one rule, not thirteen: the copula is
# inflectional variation (だ / である / であった / でした) and the research unit
# is the head. `output_name` supplies the name; this supplies the span.
#
# `evidence: raw` is forced, not chosen: `DA` is a fragment and never emits, so
# its records come from the synthesized `__policy__DA` emitter.
policy
  # Stage 1 — `deduplicate_longest(group=layer)`. One statement: `partition:
  # layer` subdivides the selected set by each definition's `layer` metadata
  # and runs the rank contest independently per class, so the layers never
  # resolve against each other — that cross-layer contest is stage 4's job.
  resolve all partition: layer, rank: [longest, start, end, pattern].
  # Stage 2 — `filter_teiru_negation`. The subject is `@ている` alone, not an
  # aspect group: upstream's `_TEIRU_NAMES` is a one-element set, and `てくる`
  # is subject only to stage 3.
  exclude @ている with: @NEG, relation: after, evidence: raw.
  # Stage 3 — `filter_passive_before_aspect`. The subject is the *passive*:
  # upstream drops the `される` that an aspect consumed, not the aspect. The
  # aspect starts where the passive ends, which is `after`.
  #
  # `evidence: current` because upstream computes `aspect_starts` from the set
  # surviving stages 1-2, not from the raw stream. It is the only `current` in
  # this block.
  exclude @される with: %aspect, relation: after, evidence: current.
  # Stage 4 — `suppress_inner_layers`. The cross-layer contest, and the only
  # statement that ranks by `priority_order`: within one layer there is no
  # layer to break a tie. Lower wins, so S3 (0) is outermost, which is
  # upstream's `_LAYER_PRIORITY` sorted ascending.
  resolve patterns rank: [longest, priority_order, start, end, pattern].
  detach %trailing_copula with: @DA, relation: at_end, evidence: raw.
  # Stage 6 — `filter_sentence_final`. Position is load-bearing: `admit` reads
  # the *published* end, so standing after the `detach` measures the distance on
  # the trimmed record, which is what upstream does by running its stage 6 after
  # its stage 5.
  #
  # The anchor is `propositional_end`, not the reserved `sentence_end`.
  # `filter_pipeline.py:100` passes `effective_end` — the citation- and
  # attribution-stripped end — to this stage and to the という stage alike, so
  # both must read one anchor.
  admit all terminal: {within: 5, anchor: propositional_end}.
  admit @という terminal: {exact: true, anchor: propositional_end}.
  # Stage 8 — `filter_s0_requires_upper_layer`. A sentence-wide presence test,
  # not an overlap contest: any surviving non-S0 record licenses every S0 record
  # in the sentence, and `relation: in_sentence` is exactly that — the operand's
  # mere presence decides. `evidence: current` because upstream asks it of the
  # survivors, and by this point most of them are gone.
  #
  # `だ` is absent from `%s0_conditional` and so is never selected. That absence
  # is the whole of what `s0_always_keep: true` used to say.
  require %s0_conditional with: %upper_layer, relation: in_sentence, evidence: current.
end
