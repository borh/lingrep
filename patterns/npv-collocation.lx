# Approximation of `npv_matcher` and `normalize_verb_span` in
# natsume-simple's `src/natsume_simple/pattern_extraction.py`.

defaults
  status: "experimental"
  output_name: "npv"
  key: [$n.lemma, $p.lemma, $vc.span.text]
  transform: [
    {op: "truncate_before", scope: "$vc", stop: "[upos in {ADP, SCONJ, PART}]"},
    {op: "truncate_before", scope: "$vc",
     stop: "[lemma in {ます, た, から, ため, たり, こと, よう, です, べし, だ}]"},
    {op: "substitute", scope: "$vc", component: "last", attr: "lemma",
     table: {為る: "する", 居る: "いる", 成る: "なる", 有る: "ある"}},
    {op: "join", scope: "$vc"}
  ]
end

schema
  status: string required in {"experimental"}
end

set CASE_PARTICLE := {が, を, に, で, から, より, と, へ}.
set NOMINAL := {NOUN, PROPN, PRON, NUM}.
set NOUN_ROLE := {nsubj, obj, obl}.

pattern npv :=
  (?<n> [upos in @NOMINAL & dep.rel in @NOUN_ROLE])
  (?<p> [dep.rel=case & lemma in @CASE_PARTICLE])
  not_followed_by([dep.rel=fixed])
  (?<vc> (?<next> (?<v> [upos=VERB])) [upos in {AUX, SCONJ, PART, ADP, VERB}]*)
  where $v -[@NOUN_ROLE]-> $n, $n -[case]-> $p, not $n -[*]-> $next.

pattern npv_separated :=
  (?<n> [upos in @NOMINAL & dep.rel in @NOUN_ROLE])
  (?<p> [dep.rel=case & lemma in @CASE_PARTICLE])
  not_followed_by([dep.rel=fixed])
  (?<next> []) []*
  (?<vc> (?<v> [upos=VERB]) [upos in {AUX, SCONJ, PART, ADP, VERB}]*)
  where $v -[@NOUN_ROLE]-> $n, $n -[case]-> $p, not $n -[*]-> $next.
