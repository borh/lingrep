# Direct-object realization by verbal lemma and dependent class. Anonymous
# dependency-edge existence (`_`) emits one record per verbal head even when a
# head has several matching dependents, and requires a complete basic
# dependency tree on the sentence.

defaults
  status: "experimental"
end

schema
  pattern object_state: string required in {"present", "absent"}
  pattern object_class: string in {"pronominal", "nominal"}
  pattern pronominal_state: string in {"present", "absent"}
  status: string required in {"experimental"}
end

set NOMINAL_UPOS := {NOUN, PROPN}.
test PRONOMINAL_UPOS := upos=PRON.

object_state: "present"
key: [$verb.lemma]
pattern with_direct_object := (?<verb> [upos=VERB])
  where $verb -[obj|obj:*]-> _.

object_state: "absent"
key: [$verb.lemma]
pattern without_direct_object := (?<verb> [upos=VERB])
  where not $verb -[obj|obj:*]-> _.

object_state: "present"
object_class: "pronominal"
pronominal_state: "present"
key: [$verb.lemma]
pattern with_pronominal_direct_object := (?<verb> [upos=VERB])
  where $verb -[obj|obj:*]-> [@PRONOMINAL_UPOS].

object_state: "present"
pronominal_state: "absent"
key: [$verb.lemma]
pattern without_pronominal_direct_object := (?<verb> [upos=VERB])
  where $verb -[obj|obj:*]-> _,
        not $verb -[obj|obj:*]-> [@PRONOMINAL_UPOS].

object_state: "present"
object_class: "nominal"
key: [$verb.lemma]
pattern with_nominal_direct_object := (?<verb> [upos=VERB])
  where $verb -[obj|obj:*]-> [upos in @NOMINAL_UPOS].
