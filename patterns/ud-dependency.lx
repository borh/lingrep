# Exemplar for the `where` clause over CoNLL-U (`dep.head`, `dep.rel`).
# Witnesses are in `lingrep/tests/fixtures/ud-ja-gsd-sample.conllu` and
# `lingrep-core/tests/fixtures/ud-dependency-witness.conllu`.

defaults
  status: "exemplar"
end

schema
  pattern layer: string required in {"dependency"}
  status: string required in {"exemplar"}
end

layer: "dependency"
pattern adjectival_predicate_subject :=
  (?<s> [dep.rel=nsubj & upos=NOUN]) []* (?<p> [upos=ADJ])
  where $p -[nsubj]-> $s.

layer: "dependency"
pattern case_marked_nominal :=
  (?<n> [upos=NOUN]) (?<c> [upos=ADP])
  where $n -[case]-> $c.

layer: "dependency"
pattern genitive_modifier :=
  (?<m> [dep.rel=nmod]) (?<c> [text=の]) (?<h> [upos=NOUN])
  where $h -[nmod]-> $m, $m -[case]-> $c.

layer: "dependency"
pattern scrambled_arguments :=
  (?<o> [dep.rel=obj]) []* (?<s> [dep.rel=nsubj]) []* (?<v> [upos=VERB])
  where $v -[nsubj]-> $s, $v -[obj]-> $o.

set CORE_ARGUMENT := {nsubj, obj, iobj}.

# `obl:*` does not match bare `obl`, so both are listed.
layer: "dependency"
pattern verbal_argument :=
  (?<a> [upos=NOUN]) []* (?<v> [upos=VERB])
  where $v -[@CORE_ARGUMENT|obl|obl:*]-> $a.
