# Crossing basic-dependency edge pairs (`dep.head`, `dep.rel`): for token
# positions a < b < c < d, edges spanning (a, c) and (b, d) cross under all
# four direction combinations.

defaults
  status: "experimental"
end

schema
  pattern topology: string required in {"crossing_edges"}
  status: string required in {"experimental"}
end

test DEPENDENCY_RELATION := dep.rel~/.+/.

key: [$d1.dep.rel, $d2.dep.rel, $h1.upos, $h2.upos]
topology: "crossing_edges"
output_name: "crossing_edges"
pattern heads_before_dependents :=
  (?<h1> []) []* (?<h2> []) []*
  (?<d1> [@DEPENDENCY_RELATION]) []* (?<d2> [@DEPENDENCY_RELATION])
  where $h1 -[*]-> $d1, $h2 -[*]-> $d2.

key: [$d1.dep.rel, $d2.dep.rel, $h1.upos, $h2.upos]
topology: "crossing_edges"
output_name: "crossing_edges"
pattern first_edge_reversed :=
  (?<d1> [@DEPENDENCY_RELATION]) []* (?<h2> []) []*
  (?<h1> []) []* (?<d2> [@DEPENDENCY_RELATION])
  where $h1 -[*]-> $d1, $h2 -[*]-> $d2.

key: [$d1.dep.rel, $d2.dep.rel, $h1.upos, $h2.upos]
topology: "crossing_edges"
output_name: "crossing_edges"
pattern second_edge_reversed :=
  (?<h1> []) []* (?<d2> [@DEPENDENCY_RELATION]) []*
  (?<d1> [@DEPENDENCY_RELATION]) []* (?<h2> [])
  where $h1 -[*]-> $d1, $h2 -[*]-> $d2.

key: [$d1.dep.rel, $d2.dep.rel, $h1.upos, $h2.upos]
topology: "crossing_edges"
output_name: "crossing_edges"
pattern dependents_before_heads :=
  (?<d1> [@DEPENDENCY_RELATION]) []*
  (?<d2> [@DEPENDENCY_RELATION]) []* (?<h1> []) []* (?<h2> [])
  where $h1 -[*]-> $d1, $h2 -[*]-> $d2.
