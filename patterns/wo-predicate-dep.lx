# ヲ格名詞句と述語の共起 over GiNZA CoNLL-U (`dep.head`, `dep.rel`), where
# compounds are single tokens, a サ変 stem is tagged VERB, and する has
# `lemma=する`. `wo_predicate_linear` restates `sketch_wo_predicate`
# (`sketch-grammar.lx`) over XPOS so `scripts/wo_predicate_compare.py` can join
# linear and dependency matches on the を token.

defaults
  source: "research query, ヲ格名詞句と述語の共起 dependency criterion"
  status: "experimental"
end

set WO_DEP_NOMINAL := {NOUN, PROPN, PRON, NUM}.

set WO_PHRASE_ROLE := {obj, obl, iobj, nsubj, csubj, ccomp, xcomp,
                       advcl, acl, nmod, dep}.

role: "helper"
fragment wo_lin_nominal :=
  [xpos ~ /\A(名詞|代名詞)/]
  ([xpos ~ /\A接尾辞-名詞的/])*.

role: "helper"
fragment wo_lin_wo := [text=を & xpos ~ /\A助詞-格助詞/].

# Unlike `sk_gap`, excludes a サ変 stem; otherwise 発見した keys on する.
role: "helper"
fragment wo_lin_gap :=
  [xpos !~ /\A(動詞|助動詞|補助記号)/
   & xpos !~ /\A助詞-(格助詞|係助詞|接続助詞)/
   & xpos !~ /サ変可能/].

role: "helper"
fragment wo_lin_predicate :=
  ( [xpos ~ /\A名詞-普通名詞-サ変可能/] [lemma=する]
  | [xpos ~ /\A動詞/] ).

role: "research"
category: "ヲ格共起"
relation: "noun_wo+V"
head: "predicate"
collocate: "accusative"
key: [$head.first.lemma, $collocate.span.lemma]
pattern wo_predicate_linear :=
  (?<collocate> @wo_lin_nominal)
  @wo_lin_wo
  (@wo_lin_gap){0,5}
  (?<head> @wo_lin_predicate).

role: "research"
category: "ヲ格共起"
relation: "noun_wo+V"
head: "predicate"
collocate: "accusative"
key: [$head.lemma, $collocate.lemma, $collocate.dep.rel]
pattern wo_predicate_dep :=
  (?<collocate> [upos in @WO_DEP_NOMINAL])
  (?<w> [text=を & upos=ADP])
  []*
  (?<head> [upos=VERB])
  where $collocate -[case]-> $w, $head -[@WO_PHRASE_ROLE]-> $collocate.
