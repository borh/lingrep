# Positive UD valency frames for Japanese head-final clauses (`dep.head`,
# `dep.rel`). Each pattern inventories attested edges without asserting that
# no other arguments are attached to the predicate.

defaults
  status: "experimental"
end

schema
  pattern frame: string required in {"subject", "transitive", "oblique", "clausal", "relative", "adverbial"}
  status: string required in {"experimental"}
end

set SUBJECT := {nsubj, csubj, nsubj:pass, csubj:pass}.
set OBJECT := {obj}.
set OBLIQUE := {iobj, obl, obl:arg}.
set CLAUSAL_COMPLEMENT := {ccomp, xcomp}.

key: [$predicate.lemma, $subject.dep.rel, $subject.lemma]
frame: "subject"
pattern subject_predicate :=
  (?<subject> [upos in {NOUN, PROPN, PRON, VERB} & dep.rel in @SUBJECT]) []*
  (?<predicate> [upos in {VERB, ADJ, AUX}])
  where $predicate -[@SUBJECT]-> $subject.

key: [$predicate.lemma, $subject.lemma, $object.lemma]
frame: "transitive"
output_name: "transitive_frame"
pattern subject_object_predicate :=
  (?<subject> [upos in {NOUN, PROPN, PRON} & dep.rel in @SUBJECT]) []*
  (?<object> [upos in {NOUN, PROPN, PRON} & dep.rel in @OBJECT]) []*
  (?<predicate> [upos in {VERB, AUX}])
  where $predicate -[@SUBJECT]-> $subject,
        $predicate -[@OBJECT]-> $object.

key: [$predicate.lemma, $subject.lemma, $object.lemma]
frame: "transitive"
output_name: "transitive_frame"
pattern object_subject_predicate :=
  (?<object> [upos in {NOUN, PROPN, PRON} & dep.rel in @OBJECT]) []*
  (?<subject> [upos in {NOUN, PROPN, PRON} & dep.rel in @SUBJECT]) []*
  (?<predicate> [upos in {VERB, AUX}])
  where $predicate -[@SUBJECT]-> $subject,
        $predicate -[@OBJECT]-> $object.

key: [$predicate.lemma, $argument.dep.rel, $argument.lemma]
frame: "oblique"
pattern oblique_predicate :=
  (?<argument> [upos in {NOUN, PROPN, PRON} & dep.rel in @OBLIQUE]) []*
  (?<predicate> [upos in {VERB, ADJ, AUX}])
  where $predicate -[@OBLIQUE]-> $argument.

key: [$predicate.lemma, $complement.dep.rel, $complement.lemma]
frame: "clausal"
pattern clausal_complement_predicate :=
  (?<complement> [upos in {VERB, ADJ, AUX} & dep.rel in @CLAUSAL_COMPLEMENT]) []*
  (?<predicate> [upos in {VERB, ADJ, AUX}])
  where $predicate -[@CLAUSAL_COMPLEMENT]-> $complement.

key: [$head.lemma, $predicate.lemma, $argument.dep.rel, $argument.lemma]
frame: "relative"
pattern relative_clause_argument :=
  (?<argument> [upos=NOUN & dep.rel in {nsubj, obj, obl}]) []*
  (?<predicate> [upos=VERB & dep.rel=acl]) []*
  (?<head> [upos=NOUN])
  where $head -[acl]-> $predicate,
        $predicate -[nsubj|obj|obl]-> $argument.

key: [$head.lemma, $clause.lemma, $argument.dep.rel, $argument.lemma]
frame: "adverbial"
pattern adverbial_clause_argument :=
  (?<argument> [upos=NOUN & dep.rel in {nsubj, obj, obl}]) []*
  (?<clause> [upos=VERB & dep.rel=advcl]) []*
  (?<head> [upos=VERB])
  where $head -[advcl]-> $clause,
        $clause -[nsubj|obj|obl]-> $argument.
