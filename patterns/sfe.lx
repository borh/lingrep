subcategory: "う"
type: "文末尾から"
meidai: "用言終止形、ただし形容動詞語幹、"
であろう := (?<命題> @用言終止形) で あろう.

status: "FIXME"
category: "う"
subcategory: "う"
type: "文末尾から"
meidai: "用言終止形、ただし形容動詞語幹、"
う := [unidic.cform=意志推量形 & text=う].

status: "FIXME"
category: "う"
subcategory: "よう"
type: "文末尾から"
meidai: "動詞連用形 あるいは 用言1段終止形"
よう := (?<命題> @動詞連用形) [unidic.cform=意志推量形 & text~/よう$/].

ようだ := よう (だ | で ある).

category: "かもしれない"
type: "文末尾から"
かもしれない := (?<命題> @用言終止形 | [upos=NOUN] | @形状詞) か も [lemma=知れる] @NAI.
