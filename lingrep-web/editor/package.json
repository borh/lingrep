{
  "name": "lingrep-web-editor",
  "private": true,
  "version": "1.0.0",
  "description": "Vendored CodeMirror bundle for the lingrep-web lingrep patterns editor. Rebuild with: npm ci && npm run build",
  "type": "module",
  "scripts": {
    "build": "esbuild entry.js --bundle --minify --format=esm --target=es2022 --outfile=../assets/editor/vendor/codemirror.js"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.19.1",
    "@codemirror/commands": "^6.10.0",
    "@codemirror/language": "^6.11.3",
    "@codemirror/lint": "^6.9.2",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.43.6"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
