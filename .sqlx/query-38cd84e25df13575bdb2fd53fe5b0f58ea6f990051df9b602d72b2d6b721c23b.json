  "query": "WITH requested(id) AS (\n                   SELECT DISTINCT CAST(value AS INTEGER) FROM json_each(?)\n               )\n               SELECT s.id,s.document_id,s.paragraph_id,s.document_sentence_ordinal,d.source_name\n               FROM requested r JOIN sentences s ON s.id=r.id\n               JOIN documents d ON d.id=s.document_id\n               ORDER BY s.id",
