2	が	が	ADP	_	_	1	case	_	_
3	魚	魚	NOUN	_	_	5	obj	_	_
4	を	を	ADP	_	_	3	case	_	_
5	食べる	食べる	VERB	_	_	0	root	_	_
6	。	。	PUNCT	_	_	5	punct	_	_

