//! Show token features for debugging pattern matching
//!
//! Usage:
//!   cargo run --example show_tokens -- "行く"
//!
//! This displays all token features to help write correct patterns

use std::env;
use lingrep_core::dictionary::{load_dictionary_data, create_tokenizer};
use lingrep_core::token_match::{TokenInfo, TokenInfoTrait};

fn main() {
    let args: Vec<String> = env::args().collect();

    let text = args.get(1)
        .map(|s| s.as_str())
        .unwrap_or("行く");

    println!("Loading dictionary...");
    let dict_path = std::env::var("DICT_PATH")
        .expect("set DICT_PATH to a Nix UniDic artifact before running this example");
    let dict_data = load_dictionary_data(&dict_path);
    let tokenizer = create_tokenizer(&dict_data);

    println!();
    println!("Tokenizing: '{}'", text);
    println!("═{:═<78}═", "");
    println!();

    // Tokenize the text
    let mut worker = tokenizer.new_worker();
    worker.reset_sentence(text);

    let mut token_num = 0;
    while let Some(token) = worker.next_token().expect("Tokenization failed") {
        token_num += 1;

        // Create a simple TokenInfo wrapper for display
        let surface = token.surface().text().to_string();
        let features: Vec<&str> = token.features().iter().map(|f| *f).collect();

        println!("Token #{}", token_num);
        println!("  surface:   '{}'", surface);

        // Display features with labels
        let feature_names = vec!["pos", "pos1", "pos2", "pos3", "cform", "ctype", "lemma"];
        for (i, feature) in features.iter().enumerate() {
            if !feature.is_empty() {
                let name = feature_names.get(i).unwrap_or(&"unknown");
                println!("  {:<10}: '{}'", name, feature);
            }
        }

        println!();
        println!("  {}", "─".repeat(70));
        println!();
    }

    println!("═{:═<78}═", "");
    println!();
    println!("Pattern examples based on above tokens:");
    println!();
    println!("  Match by POS:            [pos=VERB]");
    println!("  Match by subcategory:    [pos1=形状詞]");
    println!("  Match by conjugation:    [cform=終止形]");
    println!("  Match by surface:        [orth=行く]");
    println!("  Match by lemma:          [lemma=行く]");
    println!("  Regex match:             [pos=/VERB|AUX/]");
    println!();
}
